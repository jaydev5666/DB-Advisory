# ─────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION (.env)
# ─────────────────────────────────────────────────────────────
# Port to run the Flask API (default is 5005)
PORT=5005

# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/db_advisory

# Allow invalid TLS certificates for local testing (default is false)
MONGO_TLS_ALLOW_INVALID=false

# Allowed CORS origins (comma-separated, default is *)
CORS_ALLOWED_ORIGINS=*

# Secret key used for signing JWT login tokens (required in production)
JWT_SECRET=your_jwt_secret_key_here

# LLM Provider API Key (OpenAI, OpenRouter, or Gemini API keys)
API_KEY=sk-proj-xxxxxxxx

# Third-party Market & News API Keys (Optional fallbacks)
ALPHA_VANTAGE_KEY=
NEWS_API_KEY=
TWELVE_DATA_KEY=
FINNHUB_KEY=

# Seed admin credentials (default will fallback if omitted)
ADMIN_EMAIL=admin@dbadvisory.local
ADMIN_PASSWORD=change_me_to_something_secure


# ─────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (frontend/.env)
# ─────────────────────────────────────────────────────────────
# Base API URL pointing to Flask backend (default is http://localhost:5005)
VITE_API_BASE_URL=http://localhost:5005

# Google Client ID for Google OAuth login feature
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
